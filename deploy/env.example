# Скопировать на сервер в /srv/robot-kg/.env и заполнить.
# Файл .env НЕ коммитится в git.

DJANGO_DEBUG=0
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=заменить-на-длинный-случайный-ключ
DJANGO_ALLOWED_HOSTS=robot.kg,www.robot.kg
DJANGO_CSRF_TRUSTED_ORIGINS=https://robot.kg,https://www.robot.kg
